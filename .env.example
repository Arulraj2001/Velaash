# ==============================================================================
# Velaash E-Commerce Platform — Environment Variables Template
# Legal Entity: VELAASH TRADER'S
# Production Host: Netlify (OpenNext Next.js Runtime)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development.
# 2. For Netlify production, configure these under Site Settings > Environment Variables.
# 3. Security Rule: Any variable prefixed with NEXT_PUBLIC_ is bundled into client JS.
#    NEVER prefix secrets, service role keys, or webhook secrets with NEXT_PUBLIC_.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION ENVIRONMENT
# ==============================================================================
# [SERVER-ONLY] [REQUIRED]
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# [PUBLIC CLIENT-SAFE] [OPTIONAL — defaults to https://velaash.in]
# Canonical origin URL of the store. Used for metadataBase, sitemap, OpenGraph, canonical links.
# In production on Netlify, set to your live custom domain (https://velaash.in).
NEXT_PUBLIC_APP_URL=https://velaash.in


# ==============================================================================
# 2. SUPABASE (DATABASE, AUTH, STORAGE)
# ==============================================================================
# [PUBLIC CLIENT-SAFE] [REQUIRED]
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [PUBLIC CLIENT-SAFE] [REQUIRED]
# Supabase anonymous API key. Safe for browser usage; protected by database Row-Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# [SERVER-ONLY SECRET] [REQUIRED FOR PRODUCTION]
# CRITICAL: Bypasses Row-Level Security entirely! NEVER EXPOSE TO CLIENT OR BROWSER!
# Strictly required for server-side order insertion, inventory deduction, admin actions,
# and Razorpay asynchronous webhook processing.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-never-expose


# ==============================================================================
# 3. RAZORPAY PAYMENT GATEWAY
# ==============================================================================
# [PUBLIC CLIENT-SAFE] [OPTIONAL — runs in mock mode if unset or placeholder]
# Public key to initialize the Razorpay Standard Checkout modal.
# In production, this MUST start with 'rzp_live_' (build fails if test key used in production).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId

# [SERVER-ONLY SECRET] [OPTIONAL — runs in mock mode if unset or placeholder]
# Used for server-side order creation and cryptographic payment signature verification.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# [SERVER-ONLY SECRET] [OPTIONAL — required for live server-to-server webhook confirmation]
# Secret configured in Razorpay Dashboard > Webhooks for HMAC-SHA256 signature verification.
# Webhook URL to register: https://velaash.in/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# ==============================================================================
# 4. TRANSACTIONAL EMAIL (RESEND)
# ==============================================================================
# [SERVER-ONLY SECRET] [OPTIONAL — logs mock dispatch to console if unset]
# Required for dispatching customer order receipts, welcome emails, and payment failure notices.
RESEND_API_KEY=re_your_resend_api_key_here

# [SERVER-ONLY] [OPTIONAL — defaults to 'Velaash <orders@velaash.in>']
# Sender identity. Must use a verified domain in Resend Dashboard for live delivery.
# In development, Resend sandbox permits 'onboarding@resend.dev'.
EMAIL_FROM="Velaash <orders@velaash.in>"


# ==============================================================================
# 5. SHIPROCKET LOGISTICS & COURIER FULFILLMENT
# ==============================================================================
# [SERVER-ONLY SECRET] [OPTIONAL — runs in mock fallback mode if unset]
# Account credentials for Shiprocket Logistics API (v1 external).
# Required for live pincode serviceability checks, dynamic shipping rates, and admin "Push to Shiprocket".
SHIPROCKET_EMAIL=your_shiprocket_login_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password


# ==============================================================================
# 6. DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ==============================================================================
# [SERVER-ONLY SECRET] [OPTIONAL — falls back to local in-memory sliding window if unset]
# High-performance serverless Redis REST connection for multi-instance rate limiting
# on COD checkout orders, guest tracking attempts, and checkout anti-spam.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token


# ==============================================================================
# 7. SENTRY ERROR MONITORING & SOURCE MAPS
# ==============================================================================
# [PUBLIC CLIENT-SAFE] [OPTIONAL — graceful skip if unset]
# Sentry DSN for capturing client-side errors, unhandled promise rejections,
# and server action/API route exceptions.
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/7890123

# [SERVER-ONLY SECRET] [OPTIONAL — disables source map upload during build if unset]
# Auth token with project:write scope for uploading source maps during Netlify builds.
SENTRY_AUTH_TOKEN=sntrys_your_sentry_auth_token_here

# [SERVER-ONLY] [OPTIONAL]
# Sentry organization slug (e.g. 'velaash')
SENTRY_ORG=your-sentry-org-slug

# [SERVER-ONLY] [OPTIONAL]
# Sentry project slug (e.g. 'velaash-nextjs')
SENTRY_PROJECT=velaash-nextjs


# ==============================================================================
# 8. WEB ANALYTICS & MARKETING ATTRIBUTION
# ==============================================================================
# [PUBLIC CLIENT-SAFE] [OPTIONAL — gated strictly behind customer cookie consent]
# Leave empty if not yet provisioned. Scripts are NEVER loaded until the customer clicks 'Accept'.

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID (Format: numeric string)
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity Project ID (Format: alphanumeric string)
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id


# ==============================================================================
# 9. SEARCH ENGINE VERIFICATION
# ==============================================================================
# [PUBLIC CLIENT-SAFE] [OPTIONAL — graceful skip if unset]
# Google Search Console HTML tag verification code (content attribute value only).
# Example: If verification tag is <meta name="google-site-verification" content="abc123xyz" />, set:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

