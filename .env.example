# ==============================================================================
# Velaash E-Commerce - Environment Configuration
# Legal Entity: VELAASH TRADER'S
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# CRITICAL SECURITY NOTICE:
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — NEVER EXPOSE TO CLIENT BUNDLES OR PUBLIC REPOSITORIES!
# This key bypasses Row-Level Security (RLS) entirely. It must NEVER have a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Payment Gateway (Razorpay) Configuration
# ==============================================================================
# PUBLIC CLIENT KEY (Safe for browser bundle — used to initialize Razorpay Checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId

# SERVER-ONLY SECRETS — NEVER EXPOSE TO CLIENT BUNDLE OR PUBLIC REPOSITORIES!
# Used for server-side order creation and cryptographic payment signature verification
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SERVER-ONLY WEBHOOK SECRET — NEVER EXPOSE!
# Used to verify HMAC-SHA256 signature on /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Future Logistics & Fulfillment (Shiprocket) Placeholders
SHIPROCKET_API_USER=
SHIPROCKET_API_PASSWORD=

# Transactional Email (Resend) — Server-Only
# Required for dispatching order confirmation and payment failure notices
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Velaash <onboarding@resend.dev>"

# ==============================================================================
# Rate Limiting & Abuse Protection (Upstash Redis)
# ==============================================================================
# SERVER-ONLY SECRETS: Used for COD rate limiting and bot mitigation
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ==============================================================================
# Web Analytics & Marketing Attribution (Client-Safe, Optional)
# Gated strictly behind explicit customer cookie consent.
# Leave blank/unset if not yet provisioned by client.
# ==============================================================================
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ==============================================================================
# Google Search Console Verification (Client-Safe, Optional)
# ==============================================================================
# Obtained from Search Console → Settings → Ownership Verification → HTML tag method.
# Copy only the 'content="..."' value (not the full <meta> tag).
# When set, Next.js will render: <meta name="google-site-verification" content="...">
# If not set, no tag is rendered. No code change needed when the client provides this.
# See README for full setup instructions.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
