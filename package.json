    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const fs = require('fs'); const p = 'node_modules/@react-pdf/hyphenate/package.json'; if (fs.existsSync(p)) { const j = JSON.parse(fs.readFileSync(p, 'utf8')); if (j.exports && j.exports['./*'] && !j.exports['./*'].default) { j.exports['./*'].default = './lib/*.js'; fs.writeFileSync(p, JSON.stringify(j, null, 2)); } }\""
  },
